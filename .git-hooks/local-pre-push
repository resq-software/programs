#!/usr/bin/env bash
# Repo-specific pre-push — runs alongside the canonical ResQ pre-push hook.
# Fails fast if cargo is missing so a broken-build push can't slip through.
set -euo pipefail

if ! command -v cargo >/dev/null 2>&1; then
    echo "❌ cargo not found; cannot run required workspace check." >&2
    exit 1
fi

echo "  Anchor/Rust: cargo check --workspace --quiet"
cargo check --workspace --quiet
